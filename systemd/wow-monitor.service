[Unit]
Description=World of Warcraft: Forever Auction House Sentinel Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/wow-auction-sentinel

# Load secrets and settings from untracked local .env file
EnvironmentFile=%h/wow-auction-sentinel/.env

ExecStart=%h/wow-auction-sentinel/venv/bin/python3 monitor.py --region us --commodities

Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
